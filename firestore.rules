rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // An admin who is active and approved.
    //
    // isApproved defaults to true here on purpose: records created before
    // approval was tracked do not carry the field, and those admins are real.
    // What is refused is an explicit false -- which is what self-registration
    // writes, and what the create rule below now insists on.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.get('isActive', false) == true &&
        adminDoc().data.get('isApproved', true) == true &&
        adminDoc().data.get('role', '') != 'pending';
    }

    // Strict Super Admin Check
    function isSuperAdmin() {
      return isAdmin() && (
        adminDoc().data.get('role', '') == 'Super Admin' || 
        adminDoc().data.get('role', '') == 'super_admin'
      );
    }

    // The centre (sub-admin) a reader belongs to, or '' for a reader who
    // belongs to none. Used to keep classroom lists inside one centre.
    function myCentre() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('referredBy', '')
        : '';
    }

    function sameCentre(centre) {
      return signedIn() && centre != '' && centre == myCentre();
    }

    function centreOf(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        ? get(/databases/$(database)/documents/users/$(userId)).data.get('referredBy', '')
        : '';
    }

    // A reader's own record, or an empty map when they have none.
    function userData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Has this reader activated this exam? examSelections is keyed by exam
    // type and written only by the backend; isPremium is the global pass an
    // admin can grant.
    function hasExam(examType) {
      return signedIn() && (
        userData().get('examSelections', {}).keys().hasAny([examType]) ||
        userData().get('isPremium', false) == true
      );
    }

    function isMine(data) {
      return signedIn() && (
        data.get('uid', '') == request.auth.uid ||
        data.get('userId', '') == request.auth.uid ||
        data.get('subAdminUid', '') == request.auth.uid
      );
    }

    // =========================================================
    // 1. ADMINS
    // =========================================================
    match /admins/{adminId} {
      // A reader looks one admin up by id -- their centre's name when a code
      // is redeemed, the teacher behind an eClassroom test. Reading the whole
      // roster is an admin's to do: it carries names, emails and phone numbers.
      allow get: if signedIn();
      allow list: if isAdmin();

      // ✅ UPDATED: Secure Self-Registration.
      // Super Admins can create any admin. 
      // New users can create their own profile, but MUST be unapproved initially,
      // EXCEPT the site owners who are hardcoded to be allowed.
      allow create: if isSuperAdmin() || (
        signedIn() 
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminId == request.auth.uid
        && request.resource.data.get('role', '') != 'Super Admin'
        && request.resource.data.get('role', '') != 'super_admin'
        && (
          // Written out, not merely absent: a record with no isApproved field
          // counts as approved above, so leaving it out would have been a way
          // in. The site owners' own records are the one exception.
          request.resource.data.isApproved == false || 
          request.auth.token.email in ['ogunfolajinf32@gmail.com', 'taiwoprints999@gmail.com']
        )
      );

      allow update: if isSuperAdmin() || (
          isOwner(adminId)
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
          && request.resource.data.get('isActive', true) == resource.data.get('isActive', true)
        );

      allow delete: if isSuperAdmin();

      // eClassroom Sub-collections
      match /notices/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(adminId) || isSuperAdmin();
      }
      match /tests/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(adminId) || isSuperAdmin();

        match /questions/{questionId} {
          allow read: if signedIn();
          allow write: if isOwner(adminId) || isSuperAdmin();
        }
        match /attempts/{studentId} {
          allow read: if isOwner(adminId) || isSuperAdmin() || (signedIn() && request.auth.uid == studentId);
          allow write: if isOwner(adminId) || isSuperAdmin() || (signedIn() && request.auth.uid == studentId);
        }
      }
      match /assignments/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(adminId) || isSuperAdmin();

        match /submissions/{studentId} {
          allow read: if isOwner(adminId) || isSuperAdmin() || (signedIn() && request.auth.uid == studentId);
          allow write: if isOwner(adminId) || isSuperAdmin() || (signedIn() && request.auth.uid == studentId);
        }
      }
      match /study_notes/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(adminId) || isSuperAdmin();
      }
    }

    // =========================================================
    // 2. USERS
    // =========================================================
    match /users/{userId} {
      // A reader sees themselves; a centre sees its own students; admins see
      // everyone. Nobody else can read another reader's profile.
      allow get: if isOwner(userId) || isAdmin() ||
        sameCentre(resource.data.get('referredBy', ''));
      allow list: if isAdmin() || sameCentre(resource.data.get('referredBy', ''));
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================
    // 3. QUESTION BANK & QUESTIONS
    // =========================================================
    // A year document holds that year's questions -- it is the paid content
    // itself, and only a reader who has activated the exam may open one. The
    // lists above it are the shop window: the store reads them to say what a
    // package covers, which has to work before anything is bought.
    match /questionBank/{examType} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();

      // JAMB, WAEC, NECO: subjects sit directly under the exam.
      match /subjects/{subjectId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin();

        match /years/{yearId} {
          allow read: if isAdmin() || hasExam(examType);
          allow write: if isSuperAdmin();

          match /{rest=**} {
            allow read: if isAdmin() || hasExam(examType);
            allow write: if isSuperAdmin();
          }
        }
      }

      // Post-UTME: each institution has its own subjects.
      match /institutions/{institutionId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin();

        match /subjects/{subjectId} {
          allow read: if signedIn();
          allow write: if isSuperAdmin();

          match /years/{yearId} {
            allow read: if isAdmin() || hasExam(examType);
            allow write: if isSuperAdmin();

            match /{rest=**} {
              allow read: if isAdmin() || hasExam(examType);
              allow write: if isSuperAdmin();
            }
          }
        }
      }
    }

    // An older, unused collection. Nothing in either app reads it; an admin
    // can still look, and only a main admin can write.
    match /questions/{document=**} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Subject names are metadata wherever they live -- study notes, admission
    // data -- so this stays open. There is deliberately no matching rule for
    // years or questions: a recursive allow anywhere would hand back the
    // question documents the rules above are there to protect. eClassroom test
    // questions have their own rule under admins/{adminId}/tests.
    match /{path=**}/subjects/{subjectId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // 4. SYLLABUS, NEWS, APP SETTINGS
    // =========================================================
    match /syllabus/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /news/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Only Super Admins can touch App Settings
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin(); 
    }

    match /admin_broadcasts/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // ADMIN NOTIFICATION 👇
    match /notifications/{document=**} {
      // Users need to read them, Admins/Sub-Admins/Super Admins need to create them
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 5. USER SUB-COLLECTIONS (Notifications, FCM Tokens)
    // =========================================================
    match /users/{userId}/notifications/{notiId} {
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/exam_history/{historyId} {
      // Scores are shown on the centre leaderboard, so a centre may read its
      // own students' history -- and no further.
      allow read: if isOwner(userId) || isAdmin() || sameCentre(centreOf(userId));
      allow write: if isOwner(userId) || isAdmin();
    }

    // =========================================================
    // 6. VOUCHERS
    // =========================================================
    match /vouchers/{voucherId} {
      // A code can be looked up by name -- that is how the unlock screen
      // checks what someone typed. Listing the collection would hand out
      // unused codes, so only admins may do that, and a buyer may list the
      // ones that are theirs.
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && (
        resource.data.get('soldToUid', '') == request.auth.uid ||
        resource.data.get('usedByUid', '') == request.auth.uid ||
        resource.data.get('subAdminId', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid
      ));
      allow create: if isAdmin();
      allow update: if isAdmin() || (
          signedIn()
          && request.resource.data.status == 'used'
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isUsed', 'usedByUid', 'usedAt', 'updatedAt'])
        );
      allow delete: if isAdmin();
    }

    // =========================================================
    // 7. PAYMENTS & AUDIT 
    // =========================================================
    match /payment_transactions/{txId} {
      // A payment carries a name, an email, an amount and an activation code,
      // and its id is guessable, so only its owner and the admins may read it.
      allow get: if isAdmin() || isMine(resource.data);
      allow list: if isAdmin() || isMine(resource.data);

      // A buyer may open a payment of their own, and only as an unpaid one:
      // the server is what marks a payment complete and attaches a code.
      allow create: if isAdmin() || (
        signedIn()
        && isMine(request.resource.data)
        && request.resource.data.get('status', 'pending') in ['pending', 'initialized']
        && request.resource.data.get('voucherCode', null) == null
      ) || (
        // The record of a code redeemed rather than bought. The app now leaves
        // this to the backend, but the build already on people's phones writes
        // it as part of the activation, and refusing it fails the activation
        // with it. getAfter() is the voucher as it stands when the transaction
        // commits, so this record cannot be invented -- it costs a real code.
        signedIn()
        && isMine(request.resource.data)
        && request.resource.data.get('status', '') == 'used'
        && request.resource.data.get('paymentMethod', '') == 'voucher'
        && getAfter(/databases/$(database)/documents/vouchers/$(request.resource.data.voucherCode))
             .data.get('usedByUid', '') == request.auth.uid
      );

      // A buyer may call their payment off, or mark the code they redeemed as
      // used. Marking it approved or completed is the server's to do.
      allow update: if isAdmin() || (
        signedIn()
        && isMine(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'voucherCode', 'updatedAt', 'failureReason', 'hiddenByUser', 'userHiddenAt', 'userHiddenByUid'])
        && request.resource.data.get('status', '') in ['pending', 'cancelled', 'failed', 'used']
      );

      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      // ✅ UPDATED: Allowing Admins to create a purchase on behalf of a user
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // 8. ADMISSION DATA (GENERIC FOR ALL SCHOOLS)
    // =========================================================
    match /{collectionId}/{docId} {
      allow read: if collectionId.matches('^[a-zA-Z0-9_]+_admission_data$');
      allow write: if collectionId.matches('^[a-zA-Z0-9_]+_admission_data$') && isSuperAdmin();

      match /{subCollectionId}/{subDocId} {
        allow read: if collectionId.matches('^[a-zA-Z0-9_]+_admission_data$');
        allow write: if collectionId.matches('^[a-zA-Z0-9_]+_admission_data$') && isSuperAdmin();
      }
    }

    // =========================================================
    // 9. STUDY NOTES
    // =========================================================
    match /study_notes/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /subjects/{subjectId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // =========================================================
    // 10. VIDEOS & TUTORIALS
    // =========================================================
    match /videos/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 11. ANNOUNCEMENTS
    // =========================================================
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // 12. DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
